{
  "manifest_version": 3,
  "name": "Security Demo Extension",
  "version": "1.0.0",
  "description": "Extension demo giáo dục cho môn Bảo mật và An toàn Thông tin",
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Security Demo Extension"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
