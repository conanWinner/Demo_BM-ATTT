{
  "name": "security-demo-extension",
  "version": "1.0.0",
  "description": "Chrome extension demo giáo dục bảo mật",
  "scripts": {
    "build": "tsc",
    "test": "jest --run",
    "test:watch": "jest"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/jest": "^29.5.12",
    "fast-check": "^3.19.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "testMatch": ["**/*.test.ts"],
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "module": "CommonJS",
          "moduleResolution": "node"
        }
      }
    }
  }
}
